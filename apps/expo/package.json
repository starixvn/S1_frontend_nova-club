  "scripts": {
    "start": "expo start --dev-client",
    "start:staging": "APP_ENV=stag yarn start --clear",
    "start:soft": "APP_ENV=soft yarn start --clear",
    "start:pre": "APP_ENV=pre yarn start --clear",
    "start:prod": "yarn start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "bundle-ios": "rm -rf CodePush/ios/* && node node_modules/.bin/react-native bundle --platform ios --entry-file index.js --bundle-output ./CodePush/ios/main.jsbundle --assets-dest ./CodePush/ios --dev false --reset-cache",
    "bundle-android": "rm -rf CodePush/android/* && node node_modules/.bin/react-native bundle --platform android --entry-file index.js --bundle-output ./CodePush/android/index.android.bundle --assets-dest ./CodePush/android --dev false --reset-cache",
    "codepush:ios:staging": "APP_ENV=stag yarn bundle-ios && appcenter codepush release -a app_team/NClub-ios -d Staging -m -t 1.0.6 -c ./CodePush/ios",
    "codepush:android:staging": "APP_ENV=stag yarn bundle-android && appcenter codepush release -a app_team/NClub-android -d Staging -m -t 1.0.6 -c ./CodePush/android",
    "codepush:ios:prod": "yarn bundle-ios && appcenter codepgush release -a app_team/NClub-ios -d Production -m -t 1.0.6 -c ./CodePush/ios",
    "codepush:android:prod": "yarn bundle-android && appcenter codepush release -a app_team/NClub-android -d Production -m -t 1.0.6 -c ./CodePush/android",
    "build:all:staging": "eas build --profile staging --platform all",
    "build:android:staging": "eas build --profile staging --platform android",
    "build:ios:staging": "eas build --profile staging --platform ios"
  },
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "name": "expo-app",
  "react-native-unimodules": {
    "android": {
      "exclude": [
        "expo-splash-screen"
      ]
    }
  }
}
