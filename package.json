{
  "name": "chlgame",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/react": "18.0.1",
    "@types/react-native": "0.67.2",
    "eslint": "^8.11.0",
    "lerna-update-wizard": "^1.1.2",
    "patch-package": "^6.4.7",
    "postinstall-postinstall": "^2.1.0",
    "turbo": "^1.1.6",
    "typescript": "^4.6.2"
  },
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "native:staging": "cd apps/expo && yarn start:staging",
    "native:soft": "cd apps/expo && yarn start:soft",
    "native:pre": "cd apps/expo && yarn start:pre",
    "native:prod": "yarn workspace expo-app start:prod",
    "ios": "cd apps/expo && yarn ios",
    "android": "cd apps/expo && yarn android",
    "web": "APP_ENV=prod yarn workspace next-app dev",
    "web:staging": "cd apps/next && APP_ENV=stag yarn next",
    "web:pre": "cd apps/next && APP_ENV=pre yarn next",
    "plus": "yarn lernaupdate --lazy",
    "reset": "find . -type dir -name node_modules | xargs rm -rf && rm -rf yarn.lock",
    "copy-assets": "node ./apps/next/scripts/copy-assets.js",
    "build:web": "yarn workspace next-app build",
    "build:web:staging": "APP_ENV=stag yarn build:web",
    "build:web:pre": "APP_ENV=pre yarn build:web",
    "build:web:soft": "APP_ENV=soft yarn build:web",
    "docker:web": "docker build -t chlgame .",
    "docker:verify": "docker run -it chlgame sh",
    "docker:run": "docker run -p 3000:3000 chlgame",
    "deploy:staging": "cd apps/expo && expo publish --release-channel staging",
    "deploy:prod": "expo publish --release-channel prod",
    "rndebug": "open 'rndebugger://set-debugger-loc?host=localhost&port=19000'",
    "build:android:staging": "cd apps/expo &&  yarn build:android:staging",
    "build:ios:staging": "cd apps/expo && yarn build:ios:staging",
    "codepush:ios:staging": "cd apps/expo && yarn codepush:ios:staging",
    "codepush:android:staging": "cd apps/expo && yarn codepush:android:staging",
    "codepush:ios:prod": "cd apps/expo && yarn codepush:ios:prod",
    "codepush:android:prod": "cd apps/expo && yarn codepush:android:prod",
    "codepush:ios:pre": "cd apps/expo && yarn codepush:ios:pre",
    "codepush:android:pre": "cd apps/expo && yarn codepush:android:pre",
    "codepush:ios:soft": "cd apps/expo && yarn codepush:ios:soft",
    "codepush:android:soft": "cd apps/expo && yarn codepush:android:soft",
    "postinstall": "patch-package"
  },
  "resolutions": {
    "@types/react": "18.0.1",
    "@types/react-native": "0.67.2",
    "react-devtools-core": "4.14.0",
    "ts-toolbelt": "^9.6.0",
    "axios": "0.27.2"
  }
}
