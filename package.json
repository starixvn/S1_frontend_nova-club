{
  "name": "vuifit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*"
  ],
  "devDependencies": {
    "@types/react": "^18.0.17",
    "@types/react-native": "^0.69.5",
    "eslint": "^8.21.0",
    "turbo": "1.8.3",
    "typescript": "^5.0.4"
  },
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "native:staging": "cd apps/expo && yarn start:staging",
    "native:soft": "cd apps/expo && yarn start:soft",
    "native:pre": "cd apps/expo && yarn start:pre",
    "native:prod": "cd apps/expo && yarn start:prod",
    "native:ios": "cd apps/expo && yarn ios",
    "web:prod": "APP_ENV=prod turbo dev",
    "web:staging": "APP_ENV=staging turbo dev",
    "web:soft": "APP_ENV=soft turbo dev",
    "web:pre": "APP_ENV=pre turbo dev",
    "web:rewards": "yarn workspace rewards-next dev",
    "kill:web": "kill -9 $(lsof -ti:3000,3001)",
    "build:web": "yarn workspace next-app build",
    "build:web:prod": "APP_ENV=prod yarn build:web",
    "build:web:staging": "APP_ENV=staging yarn build:web",
    "build:web:staging2": "APP_ENV=staging2 yarn build:web",
    "build:web:pre": "APP_ENV=pre yarn build:web",
    "build:web:soft": "APP_ENV=soft yarn build:web",
    "build:rewards": "yarn workspace rewards-next build",
    "build:rewards:prod": "APP_ENV=prod yarn build:rewards",
    "build:rewards:staging": "APP_ENV=staging yarn build:rewards",
    "build:rewards:staging2": "APP_ENV=staging2 yarn build:rewards",
    "build:rewards:pre": "APP_ENV=pre yarn build:rewards",
    "build:rewards:soft": "APP_ENV=soft yarn build:rewards",
    "docker:build": "docker build -t chlgame2 .",
    "docker:verify": "docker run -it chlgame2 sh",
    "docker:run": "docker run -p 3000:3000 chlgame2",
    "codepush:prod:ios": "cd apps/expo && yarn codepush:prod:ios",
    "codepush:prod:ios:mandatory": "cd apps/expo && yarn codepush:prod:ios:mandatory",
    "codepush:prod:android": "cd apps/expo && yarn codepush:prod:android",
    "codepush:prod:android:mandatory": "cd apps/expo && yarn codepush:prod:android:mandatory",
    "codepush:staging:ios": "cd apps/expo && yarn codepush:staging:ios",
    "codepush:staging:ios:mandatory": "cd apps/expo && yarn codepush:staging:ios:mandatory",
    "codepush:staging:android": "cd apps/expo && yarn codepush:staging:android",
    "codepush:staging:android:mandatory": "cd apps/expo && yarn codepush:staging:android:mandatory",
    "codepush:staging2:ios": "cd apps/expo && yarn codepush:staging2:ios",
    "codepush:staging2:ios:mandatory": "cd apps/expo && yarn codepush:staging2:ios:mandatory",
    "codepush:staging2:android": "cd apps/expo && yarn codepush:staging2:android",
    "codepush:staging2:android:mandatory": "cd apps/expo && yarn codepush:staging2:android:mandatory",
    "codepush:pre:ios": "cd apps/expo && yarn codepush:pre:ios",
    "codepush:pre:ios:mandatory": "cd apps/expo && yarn codepush:pre:ios:mandatory",
    "codepush:pre:android": "cd apps/expo && yarn codepush:pre:android",
    "codepush:pre:android:mandatory": "cd apps/expo && yarn codepush:pre:android:mandatory",
    "codepush:soft:ios": "cd apps/expo && yarn codepush:soft:ios",
    "codepush:soft:ios:mandatory": "cd apps/expo && yarn codepush:soft:ios:mandatory",
    "codepush:soft:android": "cd apps/expo && yarn codepush:soft:android",
    "codepush:soft:android:mandatory": "cd apps/expo && yarn codepush:soft:android:mandatory",
    "git:branch:local": "git branch --merged | grep -v master",
    "git:branch": "git branch -r --merged | sed 's/origin//' | grep -v master",
    "git:branch:sunarto": "yarn git:branch | grep /sunarto",
    "git:branch:delete-local": "thisisforreference only ==> xargs -n 1 git branch -d",
    "git:branch:delete-origin": "thisisforreference only ==> xargs -n 1 git push --delete origin",
    "git:history": "git reflog"
  },
  "resolutions": {
    "metro": "^0.73.1",
    "metro-resolver": "^0.73.1",
    "@types/react": "18.2.21",
    "@react-native/assets@1.0.0": "patch:@react-native/assets@npm%3A1.0.0#./.yarn/patches/@react-native-assets-npm-1.0.0-2165b2ba43.patch",
    "react-native-webview@11.26.0": "patch:react-native-webview@npm%3A11.26.0#./.yarn/patches/react-native-webview-npm-11.26.0-7f2711346f.patch",
    "react-native-code-push@8.0.2": "patch:react-native-code-push@npm%3A8.0.2#./.yarn/patches/react-native-code-push-npm-8.0.2-53e53c8ec6.patch",
    "expo-font@~11.1.1": "patch:expo-font@npm%3A11.1.1#./.yarn/patches/expo-font-npm-11.1.1-e30f61f5aa.patch",
    "react-native-shield-fraud-plugin@1.0.4": "patch:react-native-shield-fraud-plugin@npm%3A1.0.4#./.yarn/patches/react-native-shield-fraud-plugin-npm-1.0.4-a03692a411.patch",
    "react-native-modalfy@3.3.3": "patch:react-native-modalfy@npm%3A3.3.3#./.yarn/patches/react-native-modalfy-npm-3.3.3-e38ac7cab1.patch",
    "react-native-actions-sheet@0.8.29": "patch:react-native-actions-sheet@npm%3A0.8.29#./.yarn/patches/react-native-actions-sheet-npm-0.8.29-67be4d5903.patch"
  },
  "nohoist": [
    "**/expo-router",
    "**/expo-router/**"
  ],
  "engines": {
    "node": "^16.0.0"
  },
  "packageManager": "yarn@3.4.1",
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.10",
    "@livechat/widget-react": "^1.3.1",
    "expo-dev-client": "^2.2.1",
    "firebase": "^10.6.0",
    "patch-package": "^7.0.0",
    "postinstall-postinstall": "^2.1.0"
  }
}
