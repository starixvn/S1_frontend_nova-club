{
  "name": "vuifit",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/react": "^18.0.17",
    "@types/react-native": "^0.69.5",
    "eslint": "^8.21.0",
    "turbo": "^1.4.2",
    "typescript": "^5.0.4"
  },
  "scripts": {
    "native": "cd apps/expo && yarn start",
    "native:ios": "cd apps/expo && yarn ios",
    "web": "cd apps/next && yarn next",
    "web:staging": "cd apps/next && APP_ENV=stag yarn next",
    "build:web": "yarn workspace next-app build",
    "docker:web": "docker build -t chlgame2 .",
    "docker:verify": "docker run -it chlgame2 sh",
    "docker:run": "docker run -p 3000:3000 chlgame2"
  },
  "resolutions": {
    "metro": "^0.73.1",
    "metro-resolver": "^0.73.1",
    "@react-native/assets@1.0.0": "patch:@react-native/assets@npm%3A1.0.0#./.yarn/patches/@react-native-assets-npm-1.0.0-2165b2ba43.patch",
    "react-native-webview@11.26.0": "patch:react-native-webview@npm%3A11.26.0#./.yarn/patches/react-native-webview-npm-11.26.0-7f2711346f.patch",
    "react-native-modalfy@^3.4.0": "patch:react-native-modalfy@npm%3A3.4.0#./.yarn/patches/react-native-modalfy-npm-3.4.0-e099e20f8f.patch"
  },
  "nohoist": [
    "**/expo-router",
    "**/expo-router/**"
  ],
  "engines": {
    "node": "^16.0.0"
  },
  "packageManager": "yarn@3.4.1",
  "dependencies": {
    "@shopify/flash-list": "^1.4.3",
    "expo-dev-client": "^2.2.1",
    "patch-package": "^7.0.0",
    "postinstall-postinstall": "^2.1.0",
    "react-native-modalfy": "^3.4.0"
  }
}
